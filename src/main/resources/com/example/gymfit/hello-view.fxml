
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane styleClass="fondo"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.gymfit.HelloController">

    <fx:define>
        <ToggleGroup fx:id="grupoSexo"/>
        <ToggleGroup fx:id="grupoCuota"/>
    </fx:define>

    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu text="_Archivo">
                        <items>
                            <MenuItem text="Nuevo socio" onAction="#onNuevo"/>
                            <MenuItem text="Guardar socio" onAction="#onGuardar"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Salir" onAction="#onSalir"/>
                        </items>
                    </Menu>

                    <Menu text="_Editar">
                        <items>
                            <MenuItem text="Editar socio" onAction="#onEditar"/>
                            <MenuItem text="Duplicar socio" onAction="#onDuplicar"/>
                            <MenuItem text="Buscar socio" onAction="#onBuscar"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Dar de baja" onAction="#onBaja"/>
                        </items>
                    </Menu>

                    <Menu text="_Ver">
                        <items>
                            <CheckMenuItem fx:id="miVerBarra"
                                           text="Barra de herramientas"
                                           selected="true"
                                           onAction="#onVerBarra"/>
                        </items>
                    </Menu>

                    <Menu text="_Socios">
                        <items>
                            <MenuItem text="Añadir etiqueta" onAction="#onEtiqueta"/>
                            <MenuItem text="Ver notas" onAction="#onNotas"/>
                        </items>
                    </Menu>

                    <Menu text="_Herramientas">
                        <items>
                            <MenuItem text="Exportar lista" onAction="#onExportar"/>
                        </items>
                    </Menu>

                    <Menu text="A_yuda">
                        <items>
                            <MenuItem text="Guía de uso" onAction="#onAyuda"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <ToolBar fx:id="barra">
                <items>
                    <Button text="Nuevo socio" onAction="#onNuevo">
                        <tooltip>
                            <Tooltip text="Nuevo socio (Ctrl+N)"/>
                        </tooltip>
                    </Button>

                    <Button text="Guardar" onAction="#onGuardar">
                        <tooltip>
                            <Tooltip text="Guardar (Ctrl+S)"/>
                        </tooltip>
                    </Button>

                    <Button text="Editar" onAction="#onEditar">
                        <tooltip>
                            <Tooltip text="Editar (Ctrl+E)"/>
                        </tooltip>
                    </Button>

                    <Button text="Buscar" onAction="#onBuscar">
                        <tooltip>
                            <Tooltip text="Buscar (Ctrl+F)"/>
                        </tooltip>
                    </Button>

                    <Separator orientation="VERTICAL"/>

                    <Button text="Dar de baja"
                            styleClass="texto-peligro"
                            onAction="#onBaja">
                        <tooltip>
                            <Tooltip text="Dar de baja (Supr)"/>
                        </tooltip>
                    </Button>
                </items>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <HBox spacing="16">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <VBox styleClass="tarjeta"
                  spacing="14"
                  minWidth="480"
                  prefWidth="520">

                <Label styleClass="titulo" text="Alta de socio nuevo"/>

                <GridPane hgap="12" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Nombre"
                           styleClass="etiqueta"
                           GridPane.rowIndex="0"/>
                    <TextField fx:id="nombre"
                               promptText="Ej.: Ana"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="1"/>

                    <Label text="Apellidos"
                           styleClass="etiqueta"
                           GridPane.rowIndex="1"/>
                    <TextField fx:id="apellidos"
                               promptText="Ej.: García López"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="1"/>

                    <Label text="Fecha de nacimiento"
                           styleClass="etiqueta"
                           GridPane.rowIndex="2"/>
                    <DatePicker fx:id="fecha"
                                promptText="Selecciona una fecha"
                                GridPane.rowIndex="2"
                                GridPane.columnIndex="1"/>

                    <Label text="Sexo"
                           styleClass="etiqueta"
                           GridPane.rowIndex="3"/>
                    <HBox spacing="12"
                          GridPane.rowIndex="3"
                          GridPane.columnIndex="1">
                        <RadioButton text="Mujer" toggleGroup="$grupoSexo"/>
                        <RadioButton text="Hombre" toggleGroup="$grupoSexo"/>
                        <RadioButton text="Otro" toggleGroup="$grupoSexo"/>
                    </HBox>

                    <Label text="Provincia"
                           styleClass="etiqueta"
                           GridPane.rowIndex="4"/>
                    <ComboBox fx:id="provincia"
                              promptText="Selecciona provincia"
                              maxWidth="Infinity"
                              GridPane.rowIndex="4"
                              GridPane.columnIndex="1"/>

                    <Label text="Tipo de cuota"
                           styleClass="etiqueta"
                           GridPane.rowIndex="5"/>
                    <VBox spacing="6"
                          GridPane.rowIndex="5"
                          GridPane.columnIndex="1">
                        <RadioButton text="Básica" toggleGroup="$grupoCuota"/>
                        <RadioButton text="Plus" toggleGroup="$grupoCuota"/>
                        <RadioButton text="Premium" toggleGroup="$grupoCuota"/>
                        <RadioButton text="Joven" toggleGroup="$grupoCuota"/>
                        <RadioButton text="Senior" toggleGroup="$grupoCuota"/>
                    </VBox>

                    <Label text="Clases"
                           styleClass="etiqueta"
                           GridPane.rowIndex="6"/>
                    <FlowPane hgap="12"
                              vgap="8"
                              GridPane.rowIndex="6"
                              GridPane.columnIndex="1">
                        <children>
                            <CheckBox text="Spinning"/>
                            <CheckBox text="Yoga"/>
                            <CheckBox text="Pilates"/>
                            <CheckBox text="Zumba"/>
                            <CheckBox text="CrossFit"/>
                            <CheckBox text="Natación"/>
                        </children>
                    </FlowPane>

                    <Label text="IBAN"
                           styleClass="etiqueta"
                           GridPane.rowIndex="7"/>
                    <TextField fx:id="iban"
                               promptText="Ej.: ES91 2100 0418 4502 0005 1332"
                               GridPane.rowIndex="7"
                               GridPane.columnIndex="1"/>
                </GridPane>

                <VBox fx:id="panelAviso"
                      styleClass="aviso"
                      spacing="4"
                      visible="false"
                      managed="false">
                    <Label styleClass="aviso-titulo"
                           text="No se ha podido guardar el socio."/>
                    <Label fx:id="avisoTexto" wrapText="true"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Button text="Limpiar"
                            styleClass="boton-peligro"
                            onAction="#onLimpiar"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Cancelar"
                            styleClass="boton-secundario"
                            onAction="#onCancelar"/>

                    <Button text="Guardar socio"
                            styleClass="boton-principal"
                            defaultButton="true"
                            onAction="#onGuardar"/>
                </HBox>
            </VBox>

            <VBox styleClass="tarjeta"
                  spacing="12"
                  HBox.hgrow="ALWAYS">

                <Label styleClass="titulo" text="Socios registrados"/>

                <Label text="Selecciona un socio para consultar sus datos."
                       styleClass="ayuda"
                       wrapText="true"/>

                <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="100"/>
                        <TableColumn fx:id="colApellidos"
                                     text="Apellidos"
                                     prefWidth="120"/>
                        <TableColumn fx:id="colFecha"
                                     text="Fecha de nacimiento"
                                     prefWidth="130"/>
                        <TableColumn fx:id="colCuota"
                                     text="Cuota"
                                     prefWidth="90"/>
                    </columns>

                    <contextMenu>
                        <ContextMenu>
                            <items>
                                <MenuItem fx:id="ciEditar"
                                          text="Editar socio"
                                          onAction="#onEditar"/>

                                <MenuItem fx:id="ciDuplicar"
                                          text="Duplicar socio"
                                          onAction="#onDuplicar"/>

                                <MenuItem text="Añadir etiqueta"
                                          onAction="#onEtiqueta"/>

                                <MenuItem text="Ver notas"
                                          onAction="#onNotas"/>

                                <SeparatorMenuItem/>

                                <MenuItem fx:id="ciBaja"
                                          text="Dar de baja"
                                          onAction="#onBaja"/>
                            </items>
                        </ContextMenu>
                    </contextMenu>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox styleClass="barra-estado">
            <padding>
                <Insets top="8" right="15" bottom="8" left="15"/>
            </padding>

            <Label fx:id="estado"
                   text="Listo. Pulsa Ctrl+S para guardar un socio."/>
        </HBox>
    </bottom>

</BorderPane>
